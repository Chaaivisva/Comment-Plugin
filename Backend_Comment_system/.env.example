# Copy this file to .env (in this same folder) and fill in the values.
#   Windows (PowerShell / cmd):  copy .env.example .env
#   Linux / macOS:               cp .env.example .env

# Required. Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: Gmail SMTP for tag/reply notification emails.
# Leave these empty to print emails to the server console instead.
# EMAIL_HOST_PASSWORD must be a Gmail App Password, not your normal password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
